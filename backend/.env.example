# NexaOps AI - Environment Configuration Example
# All business records and demo identities are fictional.

# --- LLM Provider (Optional for real AI query generation) ---
# When omitted, the system operates in local deterministic demo mode
OPEN_ROUTER=your_openrouter_api_key_here
AI_MODEL=google/gemini-2.5-flash
AI_ENGINE=agent

# --- Database Configuration ---
# Uses SQLite locally by default with zero setup required
DATABASE_URL=sqlite:///./nexaops.db
# For production PostgreSQL / Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Authentication & JWT ---
JWT_SECRET=nexaops-portfolio-demo-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS & Client Origin ---
FRONTEND_ORIGIN=*
